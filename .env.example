# =============================================================================
# Nomadiq — Frontend environment variables template
# =============================================================================
# 1. Copy this file to `.env` (which is gitignored).
# 2. Fill in the real values from Firebase Console + Google Cloud Console.
# 3. Restart the dev server (npm run dev) to pick up changes.
# -----------------------------------------------------------------------------

# Firebase Web SDK — Get these from:
#   Firebase Console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="<project-id>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<project-id>"
VITE_FIREBASE_STORAGE_BUCKET="<project-id>.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Google Maps JavaScript API — Get from:
#   Google Cloud Console → APIs & Services → Credentials
# Required APIs: Maps JavaScript API
# IMPORTANT: restrict by HTTP referrer to localhost + your deployed domain.
VITE_GOOGLE_MAPS_API_KEY=""

# Backend API base URL (empty = same origin / Amplify proxy)
# Set to e.g. https://api.nomadiq.example if the Express server is on a
# different host from the frontend.
VITE_API_URL=""

# NOTE: Gemini API key is no longer used in the frontend — all Gemini calls
# go through the backend (`server/`) which holds the real key in `server/.env`.
